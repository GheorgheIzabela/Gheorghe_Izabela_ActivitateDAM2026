<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IGG - Inventar General Gradina"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adaugare gradina"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editScule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Scule (ex: lopata, grebla)"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/editInsecte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Insecte (ex: albine, furnici)"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/editPlante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plante (ex: trandafiri, lalele)"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/editSuprafata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Suprafata gradinii (mp)"
            android:inputType="number" />

        <Switch
            android:id="@+id/switchVremePloaie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vreme ploioasa"
            android:checked="false"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salveaza gradina" />

    </LinearLayout>
</ScrollView>